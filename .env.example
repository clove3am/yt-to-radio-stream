# Port on the host where the web UI and stream endpoints are published.
APP_PORT=8080

# Optional: use a published GHCR image instead of building locally.
# RADIO_IMAGE=ghcr.io/clove3am/yt-to-radio-stream:latest

# Protect the UI and API with HTTP Basic auth. Leave APP_PASSWORD empty to
# disable auth (only do that on a trusted network).
APP_USERNAME=admin
APP_PASSWORD=change-me

# Optional cookies file for age-restricted or bot-checked YouTube streams.
# With the default named volume this path is inside the container. See README.
YTDLP_COOKIES_FILE=/data/cookies.txt

# Optional extra yt-dlp arguments, e.g. --proxy http://proxy:3128
YTDLP_EXTRA_ARGS=

# Seconds an on-demand stream keeps running after its last listener leaves.
# Set to 0 to stop as soon as the last listener disconnects.
ON_DEMAND_IDLE_SECONDS=30

# Maximum seconds a listener waits for an on-demand stream to tune in.
ON_DEMAND_START_TIMEOUT=75

# Tuning audio while an on-demand station starts: music or silence.
TUNING_AUDIO=music

# info, warning or debug
LOG_LEVEL=info

TZ=UTC
